# Browser-visible build-time values. Never put secrets in VITE_* variables.
VITE_APP_NAME=Luas
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=8000
VITE_API_MAX_RESPONSE_BYTES=1048576
VITE_DEFAULT_LOCALE=en
VITE_BASE_PATH=/

# Dev-server only. This value is not exposed to browser source.
SPA_API_PROXY_TARGET=http://127.0.0.1:8025
