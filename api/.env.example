# Available configuration keys and safe local examples. Not every deployment
# must set every key; required combinations are enforced by typed validation.
# Precedence and lifecycle: docs/CONFIGURATION.md

APP_NAME=Luas
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8025

# Additive optional starters: organization, permission, notification, asset, setting, usage, webhook.
# Permission, setting, usage, and webhook require organization; notification and asset are independent.
OPTIONAL_STARTERS=
# Organization invitation token lifetime; used only when organization is selected.
ORGANIZATION_INVITATION_TTL=168h

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8025
SERVER_MODE=debug
SERVER_READ_TIMEOUT=60
SERVER_READ_HEADER_TIMEOUT=10
# Must exceed MIDDLEWARE_REQUEST_TIMEOUT unless set to 0 intentionally.
SERVER_WRITE_TIMEOUT=190
SERVER_IDLE_TIMEOUT=120
SERVER_MAX_HEADER_BYTES=65536
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# Leave empty when the API is reached directly. Never use 0.0.0.0/0 or ::/0.
SERVER_TRUSTED_PROXIES=

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,Organization-Id,Idempotency-Key,If-Match,X-Request-ID
CORS_EXPOSE_HEADERS=Content-Length,ETag,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

# Optional Error Tracking
SENTRY_DSN=

# Database Configuration
DB_ENABLED=true
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=luas
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600
DB_LOG_LEVEL=
DB_SLOW_THRESHOLD=1s
DB_LOG_IGNORE_NOT_FOUND=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue / Workflow
QUEUE_DRIVER=sync
QUEUE_DEFAULT=default
QUEUE_BUFFER_SIZE=256
QUEUE_WORKER_CONCURRENCY=1
QUEUE_WORKER_SLEEP=1s
QUEUE_WORKER_TIMEOUT=60s
SCHEDULER_ENABLED=false

# JWT Configuration
# Generate with: openssl rand -hex 32
# Production must use a real value >= 32 chars. The placeholder below will be
# rejected by config validation when APP_ENV=production.
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE_DAYS=7

# Log Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_STDOUT=true
LOG_FILE_ENABLED=true
LOG_JSON=false

# Middleware Configuration
MIDDLEWARE_REQUEST_TIMEOUT=180  # Cooperative request timeout in seconds (default: 180 = 3 minutes)
MIDDLEWARE_BODY_LIMIT_MB=10     # Max request body size in MB (default: 10)
# MIDDLEWARE_RATE_LIMIT_ENABLED=true # Optional override; defaults to true in production and false otherwise
MIDDLEWARE_RATE_LIMIT_MAX=600       # Max requests per window per client IP
MIDDLEWARE_RATE_LIMIT_WINDOW=1m     # Rate limit window duration
MIDDLEWARE_RATE_LIMIT_SKIP_PATHS=/health,/health/live,/health/ready,/metrics,/v1/health
# Public auth abuse protection. Defaults to enabled in production and disabled elsewhere.
# Each endpoint has an independent source-IP bucket. Login and reset flows also
# have a normalized, hashed subject bucket to resist distributed attempts.
# AUTH_RATE_LIMIT_ENABLED=true # Optional override; defaults to true in production and false otherwise
AUTH_RATE_LIMIT_LOGIN_IP_MAX=20
AUTH_RATE_LIMIT_LOGIN_IP_WINDOW=5m
AUTH_RATE_LIMIT_LOGIN_SUBJECT_MAX=10
AUTH_RATE_LIMIT_LOGIN_SUBJECT_WINDOW=15m
AUTH_RATE_LIMIT_REGISTER_IP_MAX=10
AUTH_RATE_LIMIT_REGISTER_IP_WINDOW=1h
AUTH_RATE_LIMIT_REGISTER_SUBJECT_MAX=0
AUTH_RATE_LIMIT_REGISTER_SUBJECT_WINDOW=0s
AUTH_RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
AUTH_RATE_LIMIT_PASSWORD_RESET_IP_WINDOW=1h
AUTH_RATE_LIMIT_PASSWORD_RESET_SUBJECT_MAX=3
AUTH_RATE_LIMIT_PASSWORD_RESET_SUBJECT_WINDOW=1h
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_IP_MAX=10
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_IP_WINDOW=15m
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_SUBJECT_MAX=5
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_SUBJECT_WINDOW=15m
# METRICS_ENABLED=true              # Optional override; defaults to false in production and true otherwise

# AI Capability
# Only OpenAI is built in today. Additional providers (Anthropic, Gemini, etc.)
# can be added by implementing the ai.Provider interface and registering them
# in ai.NewManager. The streaming seam is already in place — see
# ai.StreamingProvider.
# Model IDs are provider-owned values; update this for the provider you deploy.
AI_ENABLED=true
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5
AI_REQUEST_TIMEOUT=120s
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Email Capability
MAIL_FROM=
RESEND_API_KEY=
MAIL_REQUEST_TIMEOUT=10s

# Optional Object Storage Capability
# "disabled" keeps the capability inert. Selecting the asset starter defaults to
# "local" outside production; production asset deployments must explicitly use "r2".
OBJECT_STORAGE_DRIVER=disabled
OBJECT_STORAGE_LOCAL_ROOT=storage/objects
OBJECT_STORAGE_REQUEST_TIMEOUT=30s

# Asset Starter Policy
ASSET_MAX_BYTES=10485760
ASSET_UPLOAD_GRANT_TTL=10m
ASSET_DOWNLOAD_GRANT_TTL=5m
ASSET_PENDING_TTL=1h

# Outbound Webhook Starter
# Required when OPTIONAL_STARTERS includes webhook. Generate a unique deployment key,
# for example with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_REQUEST_TIMEOUT=15s
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_SECRET_OVERLAP=24h
WEBHOOK_EVENT_RETENTION=720h
# Local verification only. Both overrides are rejected in production.
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Private Cloudflare R2 / S3-compatible API credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=

# Optional OpenTelemetry Tracing
TRACING_ENABLED=false           # Enable/disable distributed tracing
TRACING_ENDPOINT=localhost:4317 # OTLP gRPC endpoint (Jaeger, Tempo, etc.)
TRACING_INSECURE=true           # Use insecure connection (for development)
TRACING_SAMPLE_RATE=1.0         # Sampling rate (0.0 to 1.0, 1.0 = sample all)
