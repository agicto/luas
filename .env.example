# ============================================================================
# Application Configuration
# ============================================================================
# Public URL of your application (used for metadata, SEO, sitemap, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# API Configuration
# ============================================================================
# Client-side API endpoint (relative for same-origin, absolute for cross-origin)
NEXT_PUBLIC_API_URL=/api

# API request timeout in milliseconds (default: 30000)
NEXT_PUBLIC_API_TIMEOUT=30000

# (Optional) Upstream API base URL for BFF proxy or direct calls
# If set, the app will attempt to connect to this backend on startup
# NEXT_PUBLIC_UPSTREAM_API_BASE=http://localhost:8080

# (Server-only) Internal API URL for SSR, defaults to NEXT_PUBLIC_API_URL
# INTERNAL_API_URL=http://localhost:3000/api

# ============================================================================
# Authentication Configuration
# ============================================================================
# Token mode: 'basic' (access token only) | 'refresh' (access + refresh tokens)
NEXT_PUBLIC_AUTH_TOKEN_MODE=refresh

# (Server-only) Token expiry settings in seconds
# AUTH_ACCESS_TOKEN_EXPIRY=900
# AUTH_REFRESH_TOKEN_EXPIRY=604800

# ============================================================================
# i18n Configuration
# ============================================================================
# Default locale: 'zh-Hans' | 'en-US'
NEXT_PUBLIC_DEFAULT_LOCALE=zh-Hans

# Set to 'false' to hide the language switcher
NEXT_PUBLIC_LOCALE_SWITCHER_ENABLED=true

# ============================================================================
# Analytics (Optional)
# ============================================================================
# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
