# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstream API (BFF)
# UPSTREAM_API_BASE is the backend URL that the Next.js API routes proxy to
UPSTREAM_API_BASE=http://localhost:8080
NEXT_PUBLIC_API_URL=/api

# Authentication Configuration
# basic: access token only | refresh: access + refresh tokens
NEXT_PUBLIC_AUTH_TOKEN_MODE=refresh

# i18n Configuration
NEXT_PUBLIC_DEFAULT_LOCALE=zh-Hans
NEXT_PUBLIC_LOCALE_SWITCHER_ENABLED=true

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
