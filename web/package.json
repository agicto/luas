{
  "name": "luas-web",
  "version": "0.1.0",
  "description": "Luas web — the Next.js + TypeScript half of the Luas AI scaffold (Luas: Irish for 'speed').",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:custom": "node ./scripts/next-runner.mjs dev --turbopack",
    "build": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "build:quiet": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "start": "pnpm exec next start",
    "start:custom": "node ./scripts/next-runner.mjs start",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rimraf .next .turbo .eslintcache *.tsbuildinfo coverage",
    "clean:all": "rimraf .next .turbo .eslintcache *.tsbuildinfo coverage node_modules",
    "reset": "pnpm clean:all && pnpm install"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "ai-scaffold",
    "vibe-coding",
    "ai-development",
    "frontend",
    "ui-components",
    "luas"
  ],
  "author": "Luas Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.7.1"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.9",
    "next-intl": "^4.13.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.40",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "ajv@<6.14.0": "6.15.0",
      "brace-expansion@<1.1.13": "1.1.15",
      "caniuse-lite": "1.0.30001800",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "flatted@<=3.4.1": "3.4.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=4.0.0 <=4.1.1": "4.3.0",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.16",
      "vite@>=7.0.0 <=7.3.4": "7.3.5"
    }
  },
  "packageManager": "pnpm@10.7.1"
}
