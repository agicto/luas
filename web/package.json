{
  "name": "luas-web",
  "version": "0.1.0",
  "description": "Luas customer-facing web application built with Next.js and TypeScript.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:custom": "node ./scripts/next-runner.mjs dev --turbopack",
    "build": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build && node ./scripts/check-proxy-manifest.mjs && node ./scripts/check-route-bundle-budget.mjs",
    "build:quiet": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build && node ./scripts/check-proxy-manifest.mjs && node ./scripts/check-route-bundle-budget.mjs",
    "bundle:analyze": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next experimental-analyze --output",
    "bundle:check": "node ./scripts/check-route-bundle-budget.mjs",
    "proxy:check": "node ./scripts/check-proxy-manifest.mjs",
    "start": "pnpm exec next start",
    "start:custom": "node ./scripts/next-runner.mjs start",
    "lint": "eslint . && node ./scripts/check-i18n-copy.mjs && node ./scripts/check-theme-contrast.mjs",
    "lint:i18n-copy": "node ./scripts/check-i18n-copy.mjs",
    "lint:theme-contrast": "node ./scripts/check-theme-contrast.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix && node ./scripts/check-i18n-copy.mjs && node ./scripts/check-theme-contrast.mjs",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rimraf .next .turbo .eslintcache *.tsbuildinfo coverage",
    "clean:all": "rimraf .next .turbo .eslintcache *.tsbuildinfo coverage node_modules",
    "reset": "pnpm clean:all && pnpm install"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "ai-scaffold",
    "vibe-coding",
    "ai-development",
    "frontend",
    "ui-components",
    "luas"
  ],
  "author": "Luas Team",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.40",
    "cross-env": "^7.0.3",
    "culori": "4.0.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "1.1.16",
      "postcss@<=8.5.17": "8.5.18",
      "sharp@<0.35.0": "0.35.0"
    }
  }
}
