# Pure Scaffold Essentials
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh-Hans
NEXT_PUBLIC_LOCALE_SWITCHER_ENABLED=true

# Same-origin production adapter for the Luas Go user starter.
# Browser requests stay on /api; only the Web server can read the upstream URL and JWT cookie.
AUTH_ADAPTER_ENABLED=false
AUTH_API_URL=
AUTH_API_TIMEOUT_MS=5000
# Required in production. Use an ingress-overwritten single-IP header such as X-Real-IP, not a chain.
AUTH_CLIENT_IP_HEADER=

# Development mock route handlers are enabled outside production by default.
# Leave this false in production unless you are intentionally deploying a demo-only web shell.
MOCK_BFF_ENABLED=false

# Required when MOCK_BFF_ENABLED=true in production runtime.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
