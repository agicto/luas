# Pure Scaffold Essentials
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh-Hans
NEXT_PUBLIC_LOCALE_SWITCHER_ENABLED=true

# Development mock route handlers are enabled outside production by default.
# Leave this false in production unless you are intentionally deploying a demo-only web shell.
MOCK_BFF_ENABLED=false

# Required when MOCK_BFF_ENABLED=true in production runtime.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
