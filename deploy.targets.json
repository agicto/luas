{
  "targets": [
    {
      "name": "platform-docker-host",
      "displayName": "Platform Docker Host",
      "provider": "docker",
      "workingDirectory": ".",
      "buildCommand": "echo '[platform] dynamic workspace prepared by control plane'",
      "deployCommand": "echo '[platform] use /v1/platform/services/:id/deploy to run repository deployments'",
      "healthCheckTimeout": "90s",
      "environment": {
        "DOCKER_BUILDKIT": "1"
      },
      "certificateMode": "disabled",
      "autoDeployBranches": [
        "main",
        "develop"
      ]
    },
    {
      "name": "smoke-check",
      "displayName": "Smoke Check",
      "provider": "shell",
      "workingDirectory": ".",
      "buildCommand": "echo '[smoke] validate release context'",
      "deployCommand": "echo '[smoke] start deploy' && sleep 1 && echo '[smoke] finish deploy'",
      "certificateMode": "disabled",
      "autoDeployBranches": [
        "main",
        "develop"
      ]
    },
    {
      "name": "api-local",
      "displayName": "API Local Docker Compose",
      "provider": "shell",
      "workingDirectory": ".",
      "buildCommand": "go test ./...",
      "deployCommand": "docker compose up -d --build",
      "healthCheckUrl": "http://localhost:8025/v1/health",
      "healthCheckTimeout": "60s",
      "environment": {
        "APP_ENV": "production"
      },
      "certificateMode": "disabled",
      "autoDeployBranches": [
        "main"
      ]
    },
    {
      "name": "web-local",
      "displayName": "Web Local Docker Compose",
      "provider": "shell",
      "workingDirectory": "../web",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build",
      "deployCommand": "docker compose up -d --build",
      "healthCheckUrl": "http://localhost:3000",
      "healthCheckTimeout": "90s",
      "environment": {
        "NODE_ENV": "production"
      },
      "certificateMode": "disabled",
      "autoDeployBranches": [
        "main"
      ]
    },
    {
      "name": "fullstack-local",
      "displayName": "Fullstack Local Release",
      "provider": "shell",
      "workingDirectory": "..",
      "deployCommand": "(cd api && docker compose up -d --build) && (cd web && docker compose up -d --build)",
      "healthCheckUrl": "http://localhost:3000",
      "healthCheckTimeout": "120s",
      "certificateMode": "disabled",
      "autoDeployBranches": [
        "main"
      ]
    }
  ]
}
