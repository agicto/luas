{
  "name": "luas-admin",
  "version": "0.1.0",
  "description": "Luas project management console, delivered as a static Vite SPA.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "type-check": "tsr generate && tsc -b --pretty false",
    "architecture-check": "node scripts/check-architecture.mjs",
    "lint": "eslint . --max-warnings=0 && node scripts/check-architecture.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsr generate && tsc -b --pretty false && vite build && node scripts/check-static-output.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist coverage .eslintcache *.tsbuildinfo"
  },
  "keywords": [
    "vite",
    "react",
    "tanstack-router",
    "typescript",
    "spa",
    "static",
    "cdn",
    "luas"
  ],
  "author": "Luas Team",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "1.1.16"
    }
  }
}
